# Copy to .env for local development.
# See src/config/env.validation.ts for the authoritative list of required vars.

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

DATABASE_URL=postgresql://reflex:reflex@localhost:5432/reflex_dev

REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-real-secret-at-least-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-real-secret-32-chars-min
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=*

# See src/main.ts / RateLimitGuard for what this governs - leave false
# unless this backend is actually deployed behind a trusted reverse proxy.
TRUST_PROXY=false

LOG_LEVEL=info
