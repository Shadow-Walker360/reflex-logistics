// Reflex Logistics — Prisma schema
//
// STATUS: Phase 1 (Foundation) + Phase 2 (Identity/Security) entities only.
//
// Spec reference: BACKEND ENGINEERING SPECIFICATION, Section 12 (Database / ERD).
// The full ERD there includes Order, Delivery, DeliveryStatusEvent, Rider,
// Vehicle, Assignment, Payment, Incident, Notification, AuditLog, etc.
// Those are intentionally NOT modeled here yet — they belong to Phase 3
// (Core Delivery Domain) and Phase 4 (Dispatch), which have not been built
// in this milestone. Modeling them now, ahead of the services that use
// them, would violate the "build in vertical slices" instruction and
// produce untested, speculative schema.
//
// Every table below implements the spec's stated principles:
//  - UUID primary keys (Section 12: avoid sequential-int cross-tenant enumeration)
//  - tenant_id on every tenant-scoped table, indexed (Section 8: multi-tenancy)
//  - created_at / updated_at on all tables
//  - enums for state fields rather than free text

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]
  customers   Customer[]
  riders      Rider[]
  vehicles    Vehicle[]
  deliveries  Delivery[]
  incidents   Incident[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

// Spec Section 7: roles are a fixed MVP set. Permission-level modeling
// (Section 7's "permissions separate from roles") is DESIGNED but deferred —
// MVP checks role membership directly in guards; see docs/decisions for the
// ADR recording this simplification.
enum UserRole {
  RETAILER
  DISPATCHER
  RIDER
  SUPPORT_ADMIN
  MANAGER_ADMIN
  SYSTEM_ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  phoneNumber  String?  @map("phone_number")
  passwordHash String   @map("password_hash")
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  lockedUntil  DateTime? @map("locked_until")
  failedLoginAttempts Int @default(0) @map("failed_login_attempts")
  // Terms & conditions acceptance (ADR-012) - required at signup. Version
  // is stored alongside the timestamp so a future ToS change can be
  // distinguished from "never accepted" and, if ever legally required,
  // re-prompted per-version rather than only per-account.
  termsAcceptedAt DateTime? @map("terms_accepted_at")
  termsVersion    String?   @map("terms_version")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  riderProfile  Rider?
  deliveriesCreated Delivery[] @relation("DeliveriesCreated")

  // A given email is unique within a tenant, not globally — two different
  // retailer organizations may legitimately share a rider's contact email
  // in principle, and MVP does not assume a single global identity space.
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// Spec Section 6 (Authentication): access tokens are short-lived and
// stateless (JWT); refresh tokens are DB-backed specifically so they can be
// revoked immediately on logout or on suspected compromise. The token value
// itself is never stored — only its hash — so a database read alone cannot
// produce a usable token.
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// Spec Section 40 (Auditing). Modeled now because Phase 2 (auth) already
// needs to record login attempts and lockouts.
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id") @db.Uuid
  context      Json?
  occurredAt   DateTime @default(now()) @map("occurred_at")

  @@index([tenantId])
  @@index([actorId])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

// Spec Section 15 (Idempotency). Generic, reusable across operation types —
// scoped by a composite key of (tenant, operation type, client-supplied key).
model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  operationType String  @map("operation_type")
  key          String
  status       IdempotencyStatus @default(PENDING)
  responseBody Json?    @map("response_body")
  responseStatus Int?   @map("response_status")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, operationType, key])
  @@map("idempotency_keys")
}

enum IdempotencyStatus {
  PENDING
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// Delivery domain (Phase 3 - P0-C/D/E)
//
// Spec reference: Section 5 (Domain Modules), Section 10 (Delivery State
// Machine), Section 12 (Database/ERD). Extends the Phase 1/2 schema rather
// than replacing it, per the build directive Section 6: "No full rewrite is
// justified... add the next schema slice immediately before or with the
// service that consumes it."
//
// Deliberate simplification, recorded as ADR-011: assignment is modeled as
// fields directly on Delivery (riderId, vehicleId, assignedAt) rather than
// a separate Assignment table. The original spec's own concurrency example
// (Section 14) operates directly on `UPDATE deliveries SET rider_id = ...`,
// which only makes sense if the assignment IS a Delivery field, not a
// separate joined table. A standalone Assignment entity would need its own
// state and its own concurrency handling, duplicating what Delivery.status
// + Delivery.riderId already express. See ADR-011 for the full trade-off.
// ---------------------------------------------------------------------------

enum DeliveryStatus {
  REQUESTED
  ASSIGNED
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
  FAILED
  REASSIGNMENT_REQUIRED
}

enum VehicleType {
  MOTORCYCLE
  CAR
  VAN
  PICKUP
  TRUCK
  LORRY
}

enum IncidentType {
  VEHICLE_BREAKDOWN
  RIDER_UNAVAILABLE
  ACCIDENT
  ROAD_BLOCKAGE
  CUSTOMER_UNREACHABLE
  WRONG_ADDRESS
  DAMAGED_GOODS
  OTHER
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  phoneNumber String   @map("phone_number")
  address     String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries Delivery[]

  @@index([tenantId])
  @@map("customers")
}

model Rider {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  isAvailable   Boolean  @default(true) @map("is_available")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles   Vehicle[]
  deliveries Delivery[]

  @@index([tenantId])
  @@index([tenantId, isAvailable])
  @@map("riders")
}

model Vehicle {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  riderId           String?     @map("rider_id") @db.Uuid
  type              VehicleType
  // Simplified capacity model for MVP (spec Section 19) - a single weight
  // ceiling is enough to implement the eligibility check in
  // DispatchService; volume/fragility/perishability are FUTURE per the
  // original spec and are not modeled until a real ranking algorithm needs
  // them (Section 18's eligibility/ranking split still applies once they
  // are added - this is not a redesign, just more fields).
  capacityWeightKg  Float       @map("capacity_weight_kg")
  isActive          Boolean     @default(true) @map("is_active")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rider      Rider?     @relation(fields: [riderId], references: [id], onDelete: SetNull)
  deliveries Delivery[]

  @@index([tenantId])
  @@map("vehicles")
}

model Delivery {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  customerId      String         @map("customer_id") @db.Uuid
  createdByUserId String         @map("created_by_user_id") @db.Uuid

  pickupAddress   String         @map("pickup_address")
  dropoffAddress  String         @map("dropoff_address")
  // Cargo requirement, simplified for MVP (spec Section 18/19) - just
  // enough for DispatchService's eligibility check to be real rather than
  // a stub. fragile/perishable/declaredValue etc. are FUTURE additions,
  // not a later redesign, once a real ranking algorithm needs them.
  weightKg        Float?         @map("weight_kg")

  status          DeliveryStatus @default(REQUESTED)
  riderId         String?        @map("rider_id") @db.Uuid
  vehicleId       String?        @map("vehicle_id") @db.Uuid
  assignedAt      DateTime?      @map("assigned_at")
  deliveredAt     DateTime?      @map("delivered_at")

  // Proof of delivery (spec Section 26) - single-use, expiring, hash-only
  // storage, same "never store the usable secret itself" pattern as
  // RefreshToken.tokenHash (Phase 2).
  proofTokenHash      String?   @map("proof_token_hash")
  proofTokenExpiresAt DateTime? @map("proof_token_expires_at")
  proofConfirmedAt    DateTime? @map("proof_confirmed_at")

  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer              @relation(fields: [customerId], references: [id])
  createdBy    User                  @relation("DeliveriesCreated", fields: [createdByUserId], references: [id])
  rider        Rider?                @relation(fields: [riderId], references: [id])
  vehicle      Vehicle?              @relation(fields: [vehicleId], references: [id])
  statusEvents DeliveryStatusEvent[]
  incidents    Incident[]

  // Spec Section 8: every list/lookup query filters by tenantId first: this
  // composite index makes "tenant's deliveries by status" (the dispatcher
  // queue, Section 4 of the build directive) an index-only scan rather than
  // a full tenant scan + filter.
  @@index([tenantId, status])
  @@index([tenantId, riderId])
  @@map("deliveries")
}

// Spec Section 11 (Delivery History) - append-only, never updated or
// deleted. This table, not Delivery.status alone, is the source of truth
// for "what actually happened" per the original spec's explicit framing.
model DeliveryStatusEvent {
  id         String          @id @default(uuid()) @db.Uuid
  deliveryId String          @map("delivery_id") @db.Uuid
  fromStatus DeliveryStatus? @map("from_status")
  toStatus   DeliveryStatus  @map("to_status")
  changedBy  String?         @map("changed_by") @db.Uuid
  changedAt  DateTime        @default(now()) @map("changed_at")
  metadata   Json?

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@map("delivery_status_events")
}

model Incident {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  deliveryId   String         @map("delivery_id") @db.Uuid
  reportedById String         @map("reported_by_id") @db.Uuid
  type         IncidentType
  description  String
  status       IncidentStatus @default(OPEN)
  createdAt    DateTime       @default(now()) @map("created_at")
  resolvedAt   DateTime?      @map("resolved_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([deliveryId])
  @@map("incidents")
}
