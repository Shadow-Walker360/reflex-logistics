# Reflex Logistics — client environment template.
# Copy to .env.local and fill in per-environment values.
# NEVER commit a real .env file. NEVER put secrets here — this is a
# browser-shipped app; anything in a VITE_ variable is public.

# --- API -------------------------------------------------------------
# Base URL of the NestJS backend API. No trailing slash.
VITE_API_BASE_URL=http://localhost:3000/api

# Request timeout in milliseconds for the API client (src/api/client.ts).
VITE_API_TIMEOUT_MS=15000

# --- Real-time (BACKEND DEPENDENCY — see client/README.md) -----------
# Transport is not yet confirmed with the backend team. Leave unset until
# an ADR/backend contract lands; src/realtime/ falls back to a no-op
# transport when this is empty. See "Backend Dependencies / API Questions"
# in client/README.md.
VITE_REALTIME_URL=

# --- Maps (BACKEND/PRODUCT DEPENDENCY — provider not yet chosen) -----
# Provider is not yet decided (Section 4.7 / 33 of the frontend spec).
# src/maps/ renders a placeholder visualization until this is set and a
# real provider adapter is wired in.
VITE_MAPS_PROVIDER=
VITE_MAPS_API_KEY=

# --- Build metadata (optional, safe to leave blank locally) ----------
VITE_APP_ENV=development
